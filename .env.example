DATABASE_URL="postgresql://user:password@host:port/database"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Site URL (use https://app.boilerroom.ai in production, http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Wiza API Key for prospecting search (leads/people)
# Get your API key from https://wiza.co/
WIZA_API_KEY="your_wiza_api_key_here"

# PDL (People Data Labs) API Key for company search
# Get your API key from https://www.peopledatalabs.com/
PDL_API_KEY="your_pdl_api_key_here"

# SendGrid API Key for email sending
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="your_sendgrid_api_key_here"
# SendGrid verified sender email (must be verified in SendGrid dashboard)
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# Twilio API credentials for calling
# Get your credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"

# Twilio API Key and Secret for browser calling (Voice SDK)
# Create an API Key at: https://console.twilio.com/us1/account/keys-credentials/api-keys
TWILIO_API_KEY="your_twilio_api_key"
TWILIO_API_SECRET="your_twilio_api_secret"

# Twilio TwiML Application SID for browser calling
# Create a TwiML App at: https://console.twilio.com/us1/develop/voice/manage/twiml-apps
# Set the Voice URL to: https://yourdomain.com/api/calls/twiml
TWILIO_TWIML_APP_SID="your_twiml_app_sid"

# Anthropic API Key for AI-powered POV and strategic briefings
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key"

# NewsAPI.ai API Key for company insights
# Get your API key from https://newsapi.ai/
NEWSAPI_AI_KEY="your_newsapi_ai_api_key"

# AssemblyAI API Key for call transcription with speaker diarization
# Get your API key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY="your_assemblyai_api_key"

# Super Admin emails (comma-separated) - these users are auto-promoted to super_admin
SUPER_ADMIN_EMAILS="sadid@boilerroom.ai"

# Unipile API for LinkedIn automation (messaging, invites, campaigns)
# Get your DSN and API key from https://developer.unipile.com
UNIPILE_API_KEY="your_unipile_api_key"
UNIPILE_BASE_URL="https://api34.unipile.com:16436"
UNIPILE_WEBHOOK_SECRET="your_unipile_webhook_secret"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."         # from Stripe Dashboard > Webhooks
NEXT_PUBLIC_APP_URL="https://app.boilerroom.ai"

# Stripe Price IDs — create these in Stripe Dashboard > Products
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_YEARLY_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_PRO_MAX_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_MAX_YEARLY_PRICE_ID="price_..."

# xAI (Grok)
GROK_API_KEY=""

# Recall.ai
RECALL_API_KEY=""
RECALL_WEBHOOK_SECRET=""
