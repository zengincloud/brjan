generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  supabaseId     String        @unique
  email          String        @unique
  firstName      String?
  lastName       String?
  avatarUrl      String?
  role           UserRole      @default(owner)
  tier           UserTier      @default(trial)
  creditsUsed    Int           @default(0)
  creditsResetAt DateTime?
  timezone       String        @default("est")
  workStartTime  String        @default("09:00")
  workEndTime    String        @default("17:00")
  workDays       String        @default("weekdays")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks            Task[]
  prospects        Prospect[]
  accounts         Account[]
  emails           Email[]
  calls            Call[]
  sequences        Sequence[]
  emailTemplates   EmailTemplate[]
  gmailIntegration   GmailIntegration?
  hubspotIntegration HubspotIntegration?
  invitationsSent  Invitation[]
  trackedEmails    TrackedEmail[]
  linkedInConversations LinkedInConversation[]
  linkedInPendingMessages LinkedInPendingMessage[]

  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  super_admin
  owner
  manager
  member
}

enum UserTier {
  trial
  starter
  pro
  pro_max
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text // What the company does
  targetAudience  String?  @db.Text // Who they sell to / ICP
  painPoints      String?  @db.Text // Common prospect pain points
  valueProposition String? @db.Text // Key value prop
  industry        String?
  website         String?
  targetEmails    Int      @default(40)
  targetCalls     Int      @default(500)
  targetLeads     Int      @default(50)
  targetLinkedin  Int      @default(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users       User[]
  invitations Invitation[]

  @@map("organizations")
}

model GmailIntegration {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailEmail     String
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  tokenExpiresAt DateTime
  scopes         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("gmail_integrations")
}

model HubspotIntegration {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalId       Int
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  tokenExpiresAt DateTime
  scopes         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("hubspot_integrations")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String
  type        TaskType
  status      TaskStatus
  priority    TaskPriority
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  contact     Json?
  company     Json?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, type, createdAt])
  @@map("tasks")
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  taskId    String
  createdAt DateTime  @default(now())
  meta      Json?
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Prospect {
  id           String         @id @default(cuid())
  name         String
  email        String?
  title        String?
  company      String?
  phone        String?
  location     String?
  linkedin     String?
  notes        String?
  status       ProspectStatus @default(new_lead)
  sequence     String?
  sequenceStep String?
  wizaData     Json?          @map("pdlData")
  povData      Json?          // AI-generated point of view data
  lastActivity DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String?
  account           Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  calls             Call[]
  prospectSequences ProspectSequence[]
  trackedEmails     TrackedEmail[]
  linkedInConversations LinkedInConversation[]

  @@unique([userId, email])
  @@index([userId])
  @@index([userId, status])
  @@index([accountId])
  @@map("prospects")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  industry     String?
  location     String?
  website      String?
  employees    Int?
  linkedin     String?
  status       AccountStatus @default(new_lead)
  sequence     String?
  sequenceStep String?
  lastActivity DateTime      @default(now())
  contacts     Int           @default(0)
  insights         Json?     // Store cached company insights
  insightsFetchedAt DateTime? // Track when insights were last fetched
  pov              Json?     // Store cached AI-generated point of view
  povFetchedAt     DateTime? // Track when POV was last generated
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospects        Prospect[]
  calls            Call[]
  accountSequences AccountSequence[]

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

model Email {
  id              String      @id @default(cuid())
  to              String
  cc              String?
  bcc             String?
  from            String
  subject         String
  bodyText        String
  bodyHtml        String?
  prospectId      String?
  accountId       String?
  templateId      String?
  emailType       EmailType   @default(one_off)
  status          EmailStatus @default(draft)
  sendgridId      String?
  scheduledFor    DateTime?
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, sentAt])
  @@map("emails")
}

model Call {
  id                   String      @id @default(cuid())
  from                 String
  to                   String
  prospectId           String?
  accountId            String?
  twilioSid            String?     @unique
  status               CallStatus  @default(queued)
  outcome              CallOutcome?
  duration             Int?
  recordingUrl         String?
  recordingSid         String?
  recordingDuration    Int?
  transcription        String?
  transcriptionStatus  String?
  notes                String?
  failureReason        String?
  startedAt            DateTime?
  endedAt              DateTime?
  metadata             Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospect             Prospect?   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  account              Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([prospectId])
  @@index([accountId])
  @@map("calls")
}

enum TaskType {
  hot_lead
  interested
  website_visit
  follow_up
  linkedin
  other
}

enum TaskStatus {
  to_do
  in_progress
  done
}

enum TaskPriority {
  high
  medium
  low
}

enum EventType {
  email_sent
  call_started
  call_completed
}

enum ProspectStatus {
  new_lead
  in_sequence
  contacted
  meeting_scheduled
  qualified
  unqualified
}

enum AccountStatus {
  new_lead
  in_sequence
  contacted
  meeting_scheduled
  customer
  churned
}

enum EmailType {
  one_off
  sequence
  priority
  template
}

enum EmailStatus {
  draft
  scheduled
  sending
  sent
  failed
  bounced
}

enum CallStatus {
  queued
  ringing
  in_progress
  completed
  failed
  busy
  no_answer
  canceled
}

enum CallOutcome {
  connected
  connected_intro_booked
  connected_referral
  connected_not_interested
  connected_info_gathered
  voicemail
  no_answer
  busy
  failed
  gatekeeper
}

model Sequence {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      SequenceStatus @default(draft)
  isActive    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  steps             SequenceStep[]
  prospectSequences ProspectSequence[]
  accountSequences  AccountSequence[]

  @@index([userId])
  @@map("sequences")
}

model SequenceStep {
  id           String           @id @default(cuid())
  sequenceId   String
  type         SequenceStepType
  name         String
  order        Int
  delayDays    Int              @default(0)
  delayHours   Int              @default(0)
  emailSubject String?
  emailBody    String?
  callScript   String?
  taskNotes    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("sequence_steps")
}

model ProspectSequence {
  id           String                 @id @default(cuid())
  prospectId   String
  sequenceId   String
  currentStep  Int                    @default(0)
  status       ProspectSequenceStatus @default(active)
  startedAt    DateTime               @default(now())
  completedAt  DateTime?
  pausedAt     DateTime?
  failedAt     DateTime?
  nextActionAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([prospectId, sequenceId])
  @@index([sequenceId])
  @@index([nextActionAt])
  @@map("prospect_sequences")
}

model AccountSequence {
  id           String                @id @default(cuid())
  accountId    String
  sequenceId   String
  currentStep  Int                   @default(0)
  status       AccountSequenceStatus @default(active)
  startedAt    DateTime              @default(now())
  completedAt  DateTime?
  pausedAt     DateTime?
  failedAt     DateTime?
  nextActionAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([accountId, sequenceId])
  @@index([sequenceId])
  @@index([nextActionAt])
  @@map("account_sequences")
}

enum SequenceStatus {
  draft
  active
  paused
  archived
}

enum SequenceStepType {
  email
  call
  linkedin
  task
  wait
}

enum ProspectSequenceStatus {
  active
  paused
  completed
  failed
}

enum AccountSequenceStatus {
  active
  paused
  completed
  failed
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  description String?
  category    String?  @default("general")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_templates")
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  token          String           @unique @default(cuid())
  role           UserRole         @default(member)
  status         InvitationStatus @default(pending)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([token])
  @@map("invitations")
}

enum InvitationStatus {
  pending
  accepted
  expired
}

// ============================================
// Chrome Extension: Email Tracking Models
// ============================================

model TrackedEmail {
  id             String      @id @default(cuid())
  recipientEmail String
  subject        String
  bodyHtml       String?     @db.Text
  prospectId     String?
  prospect       Prospect?   @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  sentAt         DateTime    @default(now())
  createdAt      DateTime    @default(now())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  opens  EmailOpen[]
  clicks EmailClick[]

  @@index([userId])
  @@index([recipientEmail])
  @@map("tracked_emails")
}

model EmailOpen {
  id             String       @id @default(cuid())
  trackedEmailId String
  trackedEmail   TrackedEmail @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  openedAt       DateTime     @default(now())
  ip             String?
  userAgent      String?

  @@index([trackedEmailId])
  @@map("email_opens")
}

model EmailClick {
  id             String       @id @default(cuid())
  trackedEmailId String
  trackedEmail   TrackedEmail @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)
  clickedAt      DateTime     @default(now())
  originalUrl    String
  ip             String?

  @@index([trackedEmailId])
  @@map("email_clicks")
}

// ============================================
// Chrome Extension: LinkedIn Messaging Bridge
// ============================================

model LinkedInConversation {
  id                String   @id @default(cuid())
  linkedinThreadId  String   // LinkedIn's internal thread/conversation ID
  participantName   String
  participantTitle  String?
  participantAvatar String?
  participantLinkedin String? // LinkedIn profile URL
  lastMessageText   String?  @db.Text
  lastMessageAt     DateTime?
  unreadCount       Int      @default(0)
  prospectId        String?
  prospect          Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages LinkedInMessage[]

  @@unique([userId, linkedinThreadId])
  @@index([userId])
  @@index([prospectId])
  @@map("linkedin_conversations")
}

model LinkedInMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   LinkedInConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  linkedinMsgId  String?  // LinkedIn's internal message ID (for dedup)
  direction      LinkedInMessageDirection
  body           String   @db.Text
  senderName     String
  status         LinkedInMessageStatus @default(delivered)
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([conversationId, linkedinMsgId])
  @@index([conversationId])
  @@map("linkedin_messages")
}

// Outbound messages queued from the web app, waiting for the extension to send
model LinkedInPendingMessage {
  id             String   @id @default(cuid())
  linkedinThreadId String // Which conversation to send to
  body           String   @db.Text
  status         LinkedInPendingStatus @default(pending)
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("linkedin_pending_messages")
}

enum LinkedInMessageDirection {
  inbound
  outbound
}

enum LinkedInMessageStatus {
  delivered
  pending
  failed
}

enum LinkedInPendingStatus {
  pending
  sending
  sent
  failed
}
